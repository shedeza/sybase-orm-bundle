{
    "name": "shedeza/sybase-orm-bundle",
    "description": "Symfony Bundle integration for shedeza/sybase-orm",
    "type": "symfony-bundle",
    "version": "2.1.2",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "shedeza/sybase-orm": "^3.0",
        "symfony/config": "^6.0|^7.0",
        "symfony/dependency-injection": "^6.0|^7.0",
        "symfony/framework-bundle": "^6.0|^7.0",
        "symfony/console": "^6.0|^7.0",
        "symfony/http-foundation": "^6.0|^7.0",
        "symfony/http-kernel": "^6.0|^7.0"
    },
    "conflict": {
        "shedeza/sybase-orm": "<3.0"
    },
    "autoload": {
        "psr-4": {
            "SybaseORM\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SybaseORM\\Bundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.50",
        "symfony/phpunit-bridge": "^6.0|^7.0",
        "symfony/web-profiler-bundle": "^6.0|^7.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "symfony/web-profiler-bundle": "For Sybase ORM debug toolbar and profiler panel",
        "symfony/twig-bundle": "Required by the web profiler panel for template rendering",
        "symfony/var-dumper": "For parameter dumping in the profiler query panel",
        "twig/twig": "Required for the web profiler panel rendering"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false
        }
    }
}
