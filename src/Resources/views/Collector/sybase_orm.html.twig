{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% set icon %}
        <span class="icon">
            {{ include('@SybaseORM/Collector/icon.svg') }}
        </span>
        <span class="sf-toolbar-value">{{ collector.queryCount }}</span>
        <span class="sf-toolbar-info-piece-additional-detail">
            <span class="sf-toolbar-label">in</span>
            <span class="sf-toolbar-value">{{ '%0.2f'|format(collector.totalTime) }}</span>
            <span class="sf-toolbar-label">ms</span>
        </span>
    {% endset %}

    {% set text %}
        <div class="sf-toolbar-info-piece">
            <b>Queries</b>
            <span class="sf-toolbar-status {{ collector.queryCount > 50 ? 'sf-toolbar-status-yellow' }}">{{ collector.queryCount }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Query time</b>
            <span>{{ '%0.2f'|format(collector.totalTime) }} ms</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Hydrations</b>
            <span>{{ collector.hydrations }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Identity Map</b>
            <span>{{ collector.identityHits }} hits / {{ collector.identityMisses }} misses</span>
        </div>
        {% if collector.lazyLoads > 0 %}
        <div class="sf-toolbar-info-piece">
            <b>Lazy loads</b>
            <span class="sf-toolbar-status {{ collector.lazyLoads > 5 ? 'sf-toolbar-status-yellow' }}">{{ collector.lazyLoads }}</span>
        </div>
        {% endif %}
        {% if collector.duplicateQueries|length > 0 %}
        <div class="sf-toolbar-info-piece">
            <b>Duplicates</b>
            <span class="sf-toolbar-status sf-toolbar-status-yellow">{{ collector.duplicateQueries|length }}</span>
        </div>
        {% endif %}
        {% if collector.slowQueries|length > 0 %}
        <div class="sf-toolbar-info-piece">
            <b>Slow queries</b>
            <span class="sf-toolbar-status sf-toolbar-status-red">{{ collector.slowQueries|length }}</span>
        </div>
        {% endif %}
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url, status: collector.hasWarnings ? 'yellow' : '' }) }}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.hasWarnings ? 'label-status-warning' }}">
        <span class="icon">
            {{ include('@SybaseORM/Collector/icon.svg') }}
        </span>
        <strong>Sybase ORM</strong>
        <span class="count">
            <span>{{ collector.queryCount }}</span>
            <span>{{ '%0.2f'|format(collector.totalTime) }} ms</span>
        </span>
    </span>
{% endblock %}

{% block panel %}
    <h2>Sybase ORM</h2>

    {# ── Summary metrics ── #}
    <div class="metrics">
        <div class="metric">
            <span class="value">{{ collector.queryCount }}</span>
            <span class="label">Queries</span>
        </div>
        <div class="metric">
            <span class="value">{{ '%0.2f'|format(collector.totalTime) }} <span class="unit">ms</span></span>
            <span class="label">Query time</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.hydrations }}</span>
            <span class="label">Hydrations</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.identityHits }} / {{ collector.identityMisses }}</span>
            <span class="label">Identity hits/misses</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.lazyLoads }}</span>
            <span class="label">Lazy loads</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.flushes }}</span>
            <span class="label">Flushes</span>
        </div>
    </div>

    {# ── Cache stats ── #}
    {% if collector.cacheHits > 0 or collector.cacheMisses > 0 or collector.cacheWrites > 0 %}
    <h3>Second-Level Cache</h3>
    <div class="metrics">
        <div class="metric">
            <span class="value">{{ collector.cacheHits }}</span>
            <span class="label">Hits</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.cacheMisses }}</span>
            <span class="label">Misses</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.cacheWrites }}</span>
            <span class="label">Writes</span>
        </div>
        {% if (collector.cacheHits + collector.cacheMisses) > 0 %}
        <div class="metric">
            <span class="value">{{ '%0.1f'|format(collector.cacheHits / (collector.cacheHits + collector.cacheMisses) * 100) }}%</span>
            <span class="label">Hit ratio</span>
        </div>
        {% endif %}
    </div>
    {% endif %}

    {# ── Transactions ── #}
    {% if collector.transactions > 0 or collector.rollbacks > 0 %}
    <h3>Transactions</h3>
    <div class="metrics">
        <div class="metric">
            <span class="value">{{ collector.transactions }}</span>
            <span class="label">Transactions</span>
        </div>
        {% if collector.rollbacks > 0 %}
        <div class="metric">
            <span class="value {{ collector.rollbacks > 0 ? 'status-error' }}">{{ collector.rollbacks }}</span>
            <span class="label">Rollbacks</span>
        </div>
        {% endif %}
        {% if collector.totalFlushTime > 0 %}
        <div class="metric">
            <span class="value">{{ '%0.2f'|format(collector.totalFlushTime) }} ms</span>
            <span class="label">Flush time</span>
        </div>
        {% endif %}
    </div>
    {% endif %}

    {# ── Connection stats ── #}
    {% if collector.connectionStats|length > 1 %}
    <h3>Connections</h3>
    <table>
        <thead>
            <tr>
                <th>Connection</th>
                <th class="text-right">Queries</th>
                <th class="text-right">Time (ms)</th>
            </tr>
        </thead>
        <tbody>
            {% for name, stats in collector.connectionStats %}
            <tr>
                <td>{{ name }}</td>
                <td class="text-right">{{ stats.queries }}</td>
                <td class="text-right">{{ '%0.2f'|format(stats.time) }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}

    {# ── Warnings ── #}
    {% if collector.lazyLoads > 5 %}
    <h3>
        <span class="label label-status-warning">⚠</span>
        Excessive Lazy Loading ({{ collector.lazyLoads }} loads)
    </h3>
    <p class="text-muted">Consider using eager loading or JOIN fetches to reduce N+1 queries.</p>
    {% endif %}

    {% if collector.duplicateQueries|length > 0 %}
    <h3>
        <span class="label label-status-warning">⚠</span>
        Duplicate Queries ({{ collector.duplicateQueries|length }})
    </h3>
    <table>
        <thead>
            <tr>
                <th>SQL</th>
                <th class="text-right">Count</th>
            </tr>
        </thead>
        <tbody>
            {% for sql, count in collector.duplicateQueries %}
            <tr>
                <td><code>{{ sql }}</code></td>
                <td class="text-right">
                    <span class="label label-status-warning">{{ count }}×</span>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}

    {% if collector.slowQueries|length > 0 %}
    <h3>
        <span class="label label-status-error">⚠</span>
        Slow Queries (&gt;100ms)
    </h3>
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>SQL</th>
                <th>Connection</th>
                <th class="text-right">Time (ms)</th>
            </tr>
        </thead>
        <tbody>
            {% for query in collector.slowQueries %}
            <tr>
                <td>{{ loop.index }}</td>
                <td><code>{{ query.sql }}</code></td>
                <td>{{ query.connection }}</td>
                <td class="text-right">
                    <span class="label label-status-error">{{ '%0.2f'|format(query.time_ms) }}</span>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}

    {# ── All queries ── #}
    <h3>Queries</h3>
    {% if collector.queries|length == 0 %}
        <div class="empty">
            <p>No queries were executed during this request.</p>
        </div>
    {% else %}
    <table>
        <thead>
            <tr>
                <th class="text-right">#</th>
                <th>SQL</th>
                <th>Parameters</th>
                <th>Connection</th>
                <th class="text-right">Time (ms)</th>
            </tr>
        </thead>
        <tbody>
            {% for query in collector.queries %}
            <tr class="{{ (query.time_ms ?? 0) > 100 ? 'status-error' : ((query.time_ms ?? 0) > 50 ? 'status-warning' : '') }}">
                <td class="text-right">{{ loop.index }}</td>
                <td>
                    <code class="sql">{{ query.sql }}</code>
                </td>
                <td>
                    {% if query.params is not empty %}
                        {{ profiler_dump(query.params) }}
                    {% else %}
                        <em>none</em>
                    {% endif %}
                </td>
                <td>{{ query.connection }}</td>
                <td class="text-right">{{ '%0.2f'|format(query.time_ms ?? 0) }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}
{% endblock %}
