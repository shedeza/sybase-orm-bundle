parameters:
    level: 5
    paths:
        - src
    parallel:
        maximumNumberOfProcesses: 4
    ignoreErrors:
        - '#PDOException#'
        - '#SplObjectStorage#'
        - '#Call to an undefined method Symfony\\Component\\Config\\Definition\\Builder\\NodeParentInterface::#'
        - identifier: missingType.iterableValue
    reportUnmatchedIgnoredErrors: false
